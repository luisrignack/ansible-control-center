# Copia este archivo a .env.docker y ajusta los valores:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d

# Clave de sesión de Flask. Genera una con:
#   openssl rand -hex 32
# Alternativa recomendada con Docker secrets:
#   ACC_SECRET_KEY_FILE=/run/secrets/acc_secret_key
ACC_SECRET_KEY=

# Administrador inicial. La contraseña solo se usa si aún no existe ningún
# usuario; mínimo 12 caracteres. Después se rota con:
#   docker compose exec app flask --app app init-admin
# Con Docker secrets: ACC_ADMIN_PASSWORD_FILE=/run/secrets/acc_admin_password
ACC_ADMIN_USERNAME=admin
ACC_ADMIN_PASSWORD=

# Mantén 1 hasta validar el flujo completo en laboratorio.
ACC_DRY_RUN=1

# Verificación estricta de la clave SSH de los hosts.
ACC_HOST_KEY_CHECKING=1

# Aprovisionamiento automático de known_hosts con ssh-keyscan. Con 1, antes
# de cada lote se añaden las huellas de los hosts que falten, incluidas IPs
# nuevas. Acepta la huella en el primer contacto (TOFU), así que en
# producción debe quedarse en 0: precarga las huellas verificadas con
# `flask --app app sync-known-hosts` o con el perfil docker-compose.lab.yml
# en una red de laboratorio aislada. El volumen acc_ssh persiste el fichero.
ACC_SSH_HOST_KEYS_AUTO=0

# Ruta alternativa de known_hosts. Vacío usa /home/acc/.ssh/known_hosts.
# ACC_KNOWN_HOSTS_FILE=

# Allowlist de redes de destino. OBLIGATORIA en producción: la aplicación no
# arranca con este valor vacío. Separa varias redes con comas.
# Ejemplo: 10.0.0.0/8,192.168.1.0/24
ACC_ALLOWED_NETWORKS=

# Entorno de la aplicación. En producción exige allowlist, clave de sesión
# explícita y verificación de claves SSH.
ACC_ENV=production

# Rol del proceso dentro del contenedor:
#   all    -> web + scheduler (por defecto)
#   web    -> solo web; requiere un servicio `scheduler` aparte
#   worker -> scheduler + mantenimiento
#   cli    -> comandos de administración
ACC_ROLE=all
ACC_SCHEDULER_ENABLED=1
# Minutos sin actividad para considerar huérfana una tarea o un lote.
ACC_RECOVERY_STALE_MINUTES=15
# Reintentos de contraseña por host y presupuesto de tiempo por lote.
# ACC_MAX_PASSWORD_ATTEMPTS=3
# ACC_BATCH_TIME_BUDGET=3600
# Timeout por playbook y máximo de hosts por operación.
# ACC_PLAYBOOK_TIMEOUT=300
# ACC_MAX_HOSTS=256
# Vigencia de una aprobación de tarea destructiva (minutos).
# ACC_APPROVAL_TTL_MINUTES=30

# ---- Estaciones Windows (WinRM) ------------------------------------------
# Puerto y transporte de WinRM. Usa 5986 con TLS si el equipo lo exige.
# El transporte ``basic`` puede necesitar LocalAccountTokenFilterPolicy.
# ACC_WINRM_PORT=5985
# ACC_WINRM_TRANSPORT=ntlm
# Validación del certificado WinRM: ``validate`` (seguro) o ``ignore``
# solo para laboratorio aislado.
# ACC_WINRM_SERVER_CERT_VALIDATION=validate

# Métricas de rendimiento en /metricas (admin). Ventana de muestras por ruta
# para p50/p95 y umbral de petición lenta en el log.
# ACC_REQUEST_METRICS=1
# ACC_REQUEST_METRICS_WINDOW=500
# ACC_SLOW_REQUEST_MS=1000

# Interfaz: menú «Configuración» con pestañas y vista «Módulos» (tarjetas que
# cada usuario quita de su panel). Con 0 se recupera el menú anterior, las
# tarjetas se muestran siempre y /modulos desaparece; no toca la base de datos.
ACC_UI_CONFIG_PANEL=1

# HSTS: déjalo en 0 con certificado autofirmado. Actívalo con un certificado
# real y un dominio estable.
ACC_HSTS=0

# Puertos publicados por Nginx.
ACC_HTTP_PORT=80
ACC_HTTPS_PORT=443

# Certificado autofirmado. TLS_SAN debe incluir el nombre/IP por el que
# accederás (por ejemplo DNS:acc.empresa.local,IP:192.168.1.50).
TLS_CN=localhost
TLS_SAN=DNS:localhost,IP:127.0.0.1
TLS_DAYS=825

# ---- Autenticación corporativa LDAPS (opcional) --------------------------
# Activa el login con la cuenta del directorio corporativo. El usuario admin
# local sigue funcionando igual y es quien promueve roles en /usuarios.
# Las contraseñas LDAPS no se guardan en la aplicación.
# ACC_LDAP_ENABLED=1
# ACC_LDAP_URL=ldaps://lds.etecsa.cu:636
# ldap:// viaja sin cifrar y se rechaza. Solo para laboratorio:
# ACC_LDAP_ALLOW_INSECURE=0
# ACC_LDAP_BIND_DN=uid=rouser,ou=Special Users,dc=etecsa,dc=cu
# Usa un archivo para no exponer la contraseña del bind en el entorno:
#   ACC_LDAP_BIND_PASSWORD_FILE=/run/secrets/acc_ldap_bind_password
# ACC_LDAP_BIND_PASSWORD=
# ACC_LDAP_USER_BASE=ou=etecsa.cu,ou=people,dc=etecsa,dc=cu
# ACC_LDAP_USER_FILTER=(objectClass=person)
# ACC_LDAP_USER_SCOPE=onelevel
# CA del directorio (si no es una CA pública conocida):
#   monta el CRT y apunta aquí, p. ej. /secrets/lds-ca.crt
# ACC_LDAP_TLS_CA_FILE=
# Solo para pruebas: no validar el certificado TLS del directorio.
# ACC_LDAP_TLS_VERIFY=0
# ACC_LDAP_DEFAULT_ROLE=viewer
