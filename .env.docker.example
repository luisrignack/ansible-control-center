# Copia este archivo a .env.docker y ajusta los valores:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d

# Clave de sesión de Flask. Genera una con:
#   openssl rand -hex 32
ACC_SECRET_KEY=

# Administrador inicial. La contraseña solo se usa si aún no existe ningún
# usuario; mínimo 12 caracteres. Después se rota con:
#   docker compose exec app flask --app app init-admin
ACC_ADMIN_USERNAME=admin
ACC_ADMIN_PASSWORD=

# Mantén 1 hasta validar el flujo completo en laboratorio.
ACC_DRY_RUN=1

# Verificación estricta de la clave SSH de los hosts.
ACC_HOST_KEY_CHECKING=1

# Allowlist de redes de destino. OBLIGATORIA en producción: la aplicación no
# arranca con este valor vacío. Separa varias redes con comas.
# Ejemplo: 10.0.0.0/8,192.168.1.0/24
ACC_ALLOWED_NETWORKS=

# Entorno de la aplicación. En producción exige allowlist, clave de sesión
# explícita y verificación de claves SSH.
ACC_ENV=production

# HSTS: déjalo en 0 con certificado autofirmado. Actívalo con un certificado
# real y un dominio estable.
ACC_HSTS=0

# Puertos publicados por Nginx.
ACC_HTTP_PORT=80
ACC_HTTPS_PORT=443

# Certificado autofirmado. TLS_SAN debe incluir el nombre/IP por el que
# accederás (por ejemplo DNS:acc.empresa.local,IP:192.168.1.50).
TLS_CN=localhost
TLS_SAN=DNS:localhost,IP:127.0.0.1
TLS_DAYS=825
