# Copia este archivo a .env (install.sh lo crea automáticamente).
# NUNCA subas .env a un repositorio.
#
# Todas las variables son opcionales salvo HORA_ADMIN_SECRET_KEY en producción.
# Los valores mostrados son los predeterminados; las líneas comentadas indican
# que puedes descomentarlas para sobrescribirlos.

# ---------------------------------------------------------------------------
# Rutas (producción)
# ---------------------------------------------------------------------------
# Por defecto: /etc/hora-admin/secrets, /var/lib/hora-admin, /var/log/hora-admin
# Para desarrollo sin sudo, descomenta y usa rutas locales:
# HORA_ADMIN_SECRETS_DIR=./instance/secrets
# HORA_ADMIN_DATA_DIR=./instance/data
# HORA_ADMIN_LOG_DIR=./instance/logs

# ---------------------------------------------------------------------------
# Clave de sesión de Flask (install.sh genera una aleatoria)
# ---------------------------------------------------------------------------
# Genera una con: openssl rand -hex 32
HORA_ADMIN_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# ---------------------------------------------------------------------------
# Flask, sesión y subidas
# ---------------------------------------------------------------------------
# Depurador Flask: NUNCA 1 en producción.
HORA_ADMIN_DEBUG=0
# Duración de la sesión en horas (1-72).
# HORA_ADMIN_SESSION_HOURS=8
# Tamaño máximo de subida en bytes (por defecto 2 MiB).
# HORA_ADMIN_MAX_UPLOAD_BYTES=2097152
# Cookies solo por HTTPS (1 detrás de un proxy TLS).
# HORA_ADMIN_COOKIE_SECURE=1
# Duración de la cookie "recordarme" en días (1-30).
# HORA_ADMIN_REMEMBER_DAYS=7
# Pepper de los hashes de contraseñas candidatas. Si no se define, se genera
# y persiste automáticamente en DATA_DIR.
# HORA_ADMIN_PASSWORD_PEPPER=cambia-este-pepper-de-64-caracteres

# ---------------------------------------------------------------------------
# Servidor de desarrollo
# ---------------------------------------------------------------------------
# HORA_ADMIN_HOST=127.0.0.1
# HORA_ADMIN_PORT=5000

# ---------------------------------------------------------------------------
# Gunicorn (producción)
# ---------------------------------------------------------------------------
# Dirección de escucha y número de workers.
# Con workers > 1 el estado SSE en memoria no se comparte.
# HORA_ADMIN_BIND=127.0.0.1:5000
# HORA_ADMIN_WORKERS=1
# Debe ser mayor que el max_wait del SSE (300 s) para no matar el worker.
# HORA_ADMIN_GUNICORN_TIMEOUT=360

# ---------------------------------------------------------------------------
# Usuario administrador inicial
# ---------------------------------------------------------------------------
HORA_ADMIN_USERNAME=admin
# Longitud mínima de la contraseña del administrador (8-128).
# HORA_ADMIN_ADMIN_PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Modo de ejecución
# ---------------------------------------------------------------------------
# 1 = DRY RUN (por defecto, simula Ansible y NO toca equipos reales).
# La interfaz no muestra un banner de simulación y el lote no guarda dry_run:
# comprueba esta variable antes de dar un cambio por real.
HORA_ADMIN_DRY_RUN=1
# Verificación estricta de la clave SSH del host (recomendado: 1).
# HORA_ADMIN_HOST_KEY_CHECKING=1

# ---------------------------------------------------------------------------
# Seguridad detrás de proxy inverso con HTTPS
# ---------------------------------------------------------------------------
# Activa solo si la app está detrás de un proxy de confianza (nginx/apache).
# HORA_ADMIN_TRUST_PROXY=1
# HSTS (por defecto sigue a COOKIE_SECURE).
# HORA_ADMIN_HSTS=1
# HORA_ADMIN_HSTS_MAX_AGE=31536000
# Cabeceras de seguridad y CSP con nonce.
# HORA_ADMIN_SECURITY_HEADERS=1
# HORA_ADMIN_CSP_ENABLED=1

# ---------------------------------------------------------------------------
# CSRF y rate limiting
# ---------------------------------------------------------------------------
# HORA_ADMIN_CSRF_ENABLED=1
# Caducidad del token CSRF en segundos (300-86400).
# HORA_ADMIN_CSRF_TIME_LIMIT=28800
# HORA_ADMIN_RATE_LIMIT_ENABLED=1
# HORA_ADMIN_LOGIN_RATE_LIMIT=10
# HORA_ADMIN_LOGIN_RATE_WINDOW=300
# HORA_ADMIN_EXEC_RATE_LIMIT=10
# HORA_ADMIN_EXEC_RATE_WINDOW=60
# HORA_ADMIN_VAULT_RATE_LIMIT=20
# HORA_ADMIN_VAULT_RATE_WINDOW=60

# ---------------------------------------------------------------------------
# Límites de red y credenciales
# ---------------------------------------------------------------------------
# HORA_ADMIN_MAX_HOSTS=256
# Prefijo CIDR mínimo aceptado (22 = /22 o más específico).
# HORA_ADMIN_MIN_CIDR_PREFIX=22
# Allowlist opcional de redes de destino, separadas por comas.
# Si está vacía no se restringe. Ejemplo: 10.0.0.0/8,192.168.1.0/24
# HORA_ADMIN_ALLOWED_NETWORKS=
# HORA_ADMIN_MAX_PASSWORDS=200
# HORA_ADMIN_MAX_PASSWORD_LENGTH=512

# ---------------------------------------------------------------------------
# Timeouts de Ansible (segundos)
# ---------------------------------------------------------------------------
# HORA_ADMIN_PING_TIMEOUT=30
# HORA_ADMIN_PLAYBOOK_TIMEOUT=300
# HORA_ADMIN_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Verificación, idempotencia y NTP (P4)
# ---------------------------------------------------------------------------
# Desviación máxima aceptada al verificar la hora exacta (segundos, 0-3600).
# HORA_ADMIN_TIME_TOLERANCE=120
# Servidores NTP por defecto para la política "configure" (separados por comas).
# HORA_ADMIN_DEFAULT_NTP_SERVERS=pool.ntp.org
# HORA_ADMIN_MAX_NTP_SERVERS=8

# ---------------------------------------------------------------------------
# Retención (RESERVADO: definido pero sin job de purga)
# ---------------------------------------------------------------------------
# Días de historial que se conservarán cuando se implemente la purga.
# HORA_ADMIN_HISTORY_DAYS=180
# Horas de retención de tareas en memoria (pendiente de implementar).
# HORA_ADMIN_JOB_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Binarios de Ansible (por defecto se autodetectan en el venv/PATH)
# ---------------------------------------------------------------------------
# HORA_ADMIN_ANSIBLE_BIN=/opt/hora-admin/.venv/bin/ansible
# HORA_ADMIN_ANSIBLE_PLAYBOOK_BIN=/opt/hora-admin/.venv/bin/ansible-playbook
# HORA_ADMIN_ANSIBLE_VAULT_BIN=/opt/hora-admin/.venv/bin/ansible-vault
# HORA_ADMIN_ANSIBLE_GALAXY_BIN=/opt/hora-admin/.venv/bin/ansible-galaxy

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# HORA_ADMIN_LOG_LEVEL=INFO
# HORA_ADMIN_LOG_TO_FILE=1
# HORA_ADMIN_LOG_MAX_BYTES=5242880
# HORA_ADMIN_LOG_BACKUPS=5
