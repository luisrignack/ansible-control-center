# Copia este archivo a .env (install.sh lo crea automáticamente).
# NUNCA subas .env a un repositorio.

# --- Rutas (producción) ---
# Por defecto: /etc/hora-admin/secrets, /var/lib/hora-admin, /var/log/hora-admin
# Para desarrollo sin sudo, descomenta y usa rutas locales:
# HORA_ADMIN_SECRETS_DIR=./instance/secrets
# HORA_ADMIN_DATA_DIR=./instance/data
# HORA_ADMIN_LOG_DIR=./instance/logs

# --- Clave de sesión de Flask (install.sh genera una aleatoria) ---
HORA_ADMIN_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# --- Modo de ejecución ---
# 1 = DRY RUN (por defecto, no ejecuta Ansible real)
HORA_ADMIN_DRY_RUN=1
# Depurador Flask: NUNCA 1 en producción.
HORA_ADMIN_DEBUG=0
# Verificación estricta de la clave SSH del host (recomendado: 1).
# HORA_ADMIN_HOST_KEY_CHECKING=1

# --- Servidor de desarrollo ---
# HORA_ADMIN_HOST=127.0.0.1
# HORA_ADMIN_PORT=5000

# --- Usuario administrador inicial ---
HORA_ADMIN_USERNAME=admin

# --- Seguridad detrás de proxy inverso con HTTPS ---
# HORA_ADMIN_COOKIE_SECURE=1

# --- Timeouts (segundos) ---
# HORA_ADMIN_PING_TIMEOUT=30
# HORA_ADMIN_PLAYBOOK_TIMEOUT=300

# --- Logging ---
# HORA_ADMIN_LOG_LEVEL=INFO
# HORA_ADMIN_LOG_TO_FILE=1
