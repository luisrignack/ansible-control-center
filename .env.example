# Copia este archivo a .env (install.sh lo crea automáticamente).
# NUNCA subas .env a un repositorio.
#
# Todas las variables son opcionales salvo, en producción, ACC_SECRET_KEY,
# ACC_ALLOWED_NETWORKS y ACC_COOKIE_SECURE=1.
# Los valores mostrados son los predeterminados; las líneas comentadas indican
# que puedes descomentarlas para sobrescribirlos.

# ---------------------------------------------------------------------------
# Rutas (producción)
# ---------------------------------------------------------------------------
# Por defecto: /etc/ansible-control-center/secrets, /var/lib/ansible-control-center, /var/log/ansible-control-center
# Para desarrollo sin sudo, descomenta y usa rutas locales:
# ACC_SECRETS_DIR=./instance/secrets
# ACC_DATA_DIR=./instance/data
# ACC_LOG_DIR=./instance/logs

# ---------------------------------------------------------------------------
# Clave de sesión de Flask (install.sh genera una aleatoria)
# ---------------------------------------------------------------------------
# Genera una con: openssl rand -hex 32
ACC_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres
# Alternativa sin exponer el secreto en el entorno (Docker secrets, systemd
# LoadCredential): ACC_SECRET_KEY_FILE=/run/secrets/acc_secret_key
# Lo mismo aplica a ACC_PASSWORD_PEPPER_FILE y ACC_ADMIN_PASSWORD_FILE.

# ---------------------------------------------------------------------------
# Flask, sesión y subidas
# ---------------------------------------------------------------------------
# Depurador Flask: NUNCA 1 en producción.
ACC_DEBUG=0
# Duración de la sesión en horas (1-72).
# ACC_SESSION_HOURS=8
# Tamaño máximo de subida en bytes (por defecto 2 MiB).
# ACC_MAX_UPLOAD_BYTES=2097152
# Cookies solo por HTTPS (1 detrás de un proxy TLS).
# ACC_COOKIE_SECURE=1
# Duración de la cookie "recordarme" en días (1-30).
# ACC_REMEMBER_DAYS=7
# Pepper de los hashes de contraseñas candidatas. Si no se define, se genera
# y persiste automáticamente en DATA_DIR.
# ACC_PASSWORD_PEPPER=cambia-este-pepper-de-64-caracteres

# ---------------------------------------------------------------------------
# Servidor de desarrollo
# ---------------------------------------------------------------------------
# ACC_HOST=127.0.0.1
# ACC_PORT=5000

# ---------------------------------------------------------------------------
# Gunicorn (producción)
# ---------------------------------------------------------------------------
# Dirección de escucha y número de workers.
# Con workers > 1 el estado SSE en memoria no se comparte.
# ACC_BIND=127.0.0.1:5000
# ACC_WORKERS=1
# Debe ser mayor que el max_wait del SSE (300 s) para no matar el worker.
# ACC_GUNICORN_TIMEOUT=330

# ---------------------------------------------------------------------------
# Usuario administrador inicial
# ---------------------------------------------------------------------------
ACC_USERNAME=admin
# Longitud mínima de la contraseña del administrador (8-128).
# ACC_ADMIN_PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Modo de ejecución
# ---------------------------------------------------------------------------
# 1 = DRY RUN (por defecto, simula los cambios y NO toca equipos reales).
# La interfaz muestra el banner, el lote guarda dry_run y el historial separa
# los hosts simulados de los reales. La vista previa SÍ inspecciona los hosts
# de verdad (solo lectura) para no ocultar fallos de red o credenciales.
ACC_DRY_RUN=1
# Verificación estricta de la clave SSH del host (recomendado: 1).
# ACC_HOST_KEY_CHECKING=1

# ---------------------------------------------------------------------------
# Seguridad detrás de proxy inverso con HTTPS
# ---------------------------------------------------------------------------
# Activa solo si la app está detrás de un proxy de confianza (nginx/apache).
# ACC_TRUST_PROXY=1
# HSTS (por defecto sigue a COOKIE_SECURE).
# ACC_HSTS=1
# ACC_HSTS_MAX_AGE=31536000
# Cabeceras de seguridad y CSP con nonce.
# ACC_SECURITY_HEADERS=1
# ACC_CSP_ENABLED=1

# ---------------------------------------------------------------------------
# CSRF y rate limiting
# ---------------------------------------------------------------------------
# ACC_CSRF_ENABLED=1
# Caducidad del token CSRF en segundos (300-86400).
# ACC_CSRF_TIME_LIMIT=28800
# ACC_RATE_LIMIT_ENABLED=1
# ACC_LOGIN_RATE_LIMIT=10
# ACC_LOGIN_RATE_WINDOW=300
# ACC_EXEC_RATE_LIMIT=10
# ACC_EXEC_RATE_WINDOW=60
# ACC_VAULT_RATE_LIMIT=20
# ACC_VAULT_RATE_WINDOW=60

# ---------------------------------------------------------------------------
# Límites de red y credenciales
# ---------------------------------------------------------------------------
# ACC_MAX_HOSTS=256
# Prefijo CIDR mínimo aceptado (22 = /22 o más específico).
# ACC_MIN_CIDR_PREFIX=22
# Allowlist de redes de destino, separadas por comas. En producción es
# obligatoria: una lista vacía aborta el arranque. En desarrollo, vacía no
# restringe. Ejemplo: 10.0.0.0/8,192.168.1.0/24
# ACC_ALLOWED_NETWORKS=
# ACC_MAX_PASSWORDS=200
# ACC_MAX_PASSWORD_LENGTH=512

# ---------------------------------------------------------------------------
# Windows / WinRM
# ---------------------------------------------------------------------------
# ACC_WINRM_PORT=5985
# Transporte: basic, ntlm o credssp.
# ACC_WINRM_TRANSPORT=ntlm
# Validación del certificado del servidor WinRM: validate (seguro) o ignore
# (solo laboratorios con certificados autofirmados).
# ACC_WINRM_SERVER_CERT_VALIDATION=validate

# ---------------------------------------------------------------------------
# Timeouts de Ansible (segundos)
# ---------------------------------------------------------------------------
# ACC_PING_TIMEOUT=30
# ACC_PLAYBOOK_TIMEOUT=300
# ACC_CONNECT_TIMEOUT=10
# Líneas de salida de Ansible conservadas en memoria por ejecución (100-100000).
# El callback de consola recibe todas; solo se acota la copia de stdout.
# ACC_MAX_OUTPUT_BUFFER_LINES=2000
# Contraseñas candidatas que se prueban como máximo contra un mismo host.
# ACC_MAX_PASSWORD_ATTEMPTS=3
# Presupuesto total de tiempo por lote en segundos. Al agotarse, los hosts
# pendientes se registran como omitidos.
# ACC_BATCH_TIME_BUDGET=3600

# ---------------------------------------------------------------------------
# Verificación, idempotencia y NTP (P4)
# ---------------------------------------------------------------------------
# Desviación máxima aceptada al verificar la hora exacta (segundos, 0-3600).
# El valor por defecto es 2 s; una tolerancia alta puede reportar como éxito
# un reloj claramente desviado.
# ACC_TIME_TOLERANCE=2
# Servidores NTP por defecto para la política "configure" (separados por comas).
# ACC_DEFAULT_NTP_SERVERS=pool.ntp.org
# ACC_MAX_NTP_SERVERS=8

# ---------------------------------------------------------------------------
# Retención al arrancar
# ---------------------------------------------------------------------------
# Días de historial de lotes que se conservarán. La purga se aplica al arrancar.
# ACC_HISTORY_DAYS=180
# Días de retención de eventos de autenticación.
# ACC_AUTH_EVENT_DAYS=365
# Horas de retención de instantáneas de tareas; se purgan al arrancar.
# ACC_JOB_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Binarios de Ansible (por defecto se autodetectan en el venv/PATH)
# ---------------------------------------------------------------------------
# ACC_ANSIBLE_BIN=/opt/ansible-control-center/.venv/bin/ansible
# ACC_ANSIBLE_PLAYBOOK_BIN=/opt/ansible-control-center/.venv/bin/ansible-playbook
# ACC_ANSIBLE_VAULT_BIN=/opt/ansible-control-center/.venv/bin/ansible-vault
# ACC_ANSIBLE_GALAXY_BIN=/opt/ansible-control-center/.venv/bin/ansible-galaxy

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# ACC_LOG_LEVEL=INFO
# ACC_LOG_TO_FILE=1
# ACC_LOG_MAX_BYTES=5242880
# ACC_LOG_BACKUPS=5
